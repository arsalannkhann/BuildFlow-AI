# --- Database (ADR-0002) ---
# Set to a real PostgreSQL URL (Docker, Supabase) to use node-postgres.
# Leave unset to run on embedded PGlite (zero-dependency dev/tests).
DATABASE_URL=
DATABASE_POOL_MAX=

# --- Supabase (auth + storage adapters) ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to a client bundle or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Authentication + background execution ---
AUTH_PROVIDER=dev
JOBS_MODE=inline
# Public organization registration is disabled unless explicitly enabled.
SIGNUPS_ENABLED=
# Synthetic seed and one-click role cards. Keep both unset in customer environments.
DEMO_SEED=
DEMO_QUICK_LOGIN=
DELETION_RECEIPT_HMAC_KEY=

# --- AI provider: "mock" (default, no keys needed) or "openai" ---
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_VISION_MODEL=
OPENAI_EMBEDDING_MODEL=

# --- Optional notification providers ---
NOTIFY_EMAIL_PROVIDER=
NOTIFY_WHATSAPP_PROVIDER=

# --- Mobile build-time public API origin ---
EXPO_PUBLIC_API_URL=

# --- Local data locations (PGlite / local-storage mode only) ---
PGLITE_DATA_DIR=.pglite
STORAGE_DIR=local-storage

# --- Repo root override for deployed containers (optional) ---
BUILDFLOW_REPO_ROOT=
