# --- Database (ADR-0002) ---
# Set to a real PostgreSQL URL (Docker, Supabase) to use node-postgres.
# Leave unset to run on embedded PGlite (zero-dependency dev/tests).
DATABASE_URL=
DATABASE_POOL_MAX=

# --- Supabase (auth + storage adapters) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to a client bundle or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider: "mock" (default, no keys needed) or "openai" ---
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- Local data locations (PGlite / local-storage mode only) ---
PGLITE_DATA_DIR=.pglite
STORAGE_DIR=local-storage

# --- Repo root override for deployed containers (optional) ---
BUILDFLOW_REPO_ROOT=
